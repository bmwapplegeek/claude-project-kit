{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/lib/hooks/run.sh\" session-start \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/lib/hooks/run.sh\" pre-bash \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
